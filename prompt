function master()
    --d1 = 2 -- ESTAMOS PROVISIONALMENTE FORZANDO AL DEMOSTRADOR A EJECUTAR EL COMPORTAMIENTO DIRECTAMENTE

    if d1 == 0 then
        detectar_zona_demostracion()
