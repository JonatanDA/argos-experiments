timer = 1
function step()

    if robot.id == "Qupa4" and 
        ( evaluator_ruido or Print_tracker_trayectory_data or Print_tracker_paciencia or Print_tracker_AL_PID or Print_tracker_python) then 
            print("Timer="..timer) 
    end

    if is_master == 1 then
        master() -- Ejecutar si es master
    else
        apprentice()
    end

    if robot.id == "Qupa4" and timer == max_time then
        print("End_simulation")
    end

    timer = timer + 1
end

