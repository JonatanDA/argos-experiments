<?xml version="1.0"?>
<argos-configuration>
  <framework>
    <experiment length="1000" ticks_per_second="10" random_seed="187014"/>
    <system threads="0"/>
  </framework>

  <controllers>
    <lua_controller id="lua">

      <actuators>
        <differential_steering implementation="default"/>
        <leds implementation="default" medium="leds"/>
        <range_and_bearing implementation="default" medium="rab"/>
      </actuators>

      <sensors>
        <footbot_proximity implementation="default" show_rays="true"/>
        <positioning implementation="default"/>
        <colored_blob_omnidirectional_camera implementation="rot_z_only" show_rays="true" medium="leds"/>
        <range_and_bearing implementation="medium" medium="rab"/>
        <footbot_base_ground implementation="rot_z_only"/>
        <footbot_motor_ground implementation="rot_z_only"/>
        <footbot_light implementation="rot_z_only"/>
      </sensors>

      <params/>
    </lua_controller>
  </controllers>

  <arena size="20,10,5" center="0,0,0.5">

    <!-- light -->
        <light id="light"
           position="2,2,1"
           orientation="0,0,0"
           color="yellow"
           intensity="3.0"
           medium="leds" />

    <!-- Floor -->
    <floor id="floor" source="loop_functions" pixels_per_meter="100"/>

     <!-- Footbots alineados lado derecho -->
    <foot-bot id="Footbot0"><body position="9,4,0" orientation="0,0,0"/><controller config="lua"/></foot-bot>
    <foot-bot id="Footbot1"><body position="9,2,0" orientation="0,0,0"/><controller config="lua"/></foot-bot>
    <foot-bot id="Footbot2"><body position="9,0,0" orientation="0,0,0"/><controller config="lua"/></foot-bot>
    <foot-bot id="Footbot3"><body position="9,-2,0" orientation="0,0,0"/><controller config="lua"/></foot-bot>
    <foot-bot id="Footbot5"><body position="9,-4,0" orientation="0,0,0"/><controller config="lua"/></foot-bot>

    <!-- Footbot4 , Maestros -->
    <foot-bot id="Footbot4">
      <body position="0.6, 0 , 0" orientation="0,0,0"/>
      <controller config="lua"/>
    </foot-bot>

    <foot-bot id="Footbot6">
      <body position="0.6, -1 , 0" orientation="0,0,0"/>
      <controller config="lua"/>
    </foot-bot>


    <!-- Muros perimetrales -->
    <box id="wall_north" size="20,0.1,0.5" movable="false"><body position="0,5,0"/></box>
    <box id="wall_south" size="20,0.1,0.5" movable="false"><body position="0,-5,0"/></box>
    <box id="wall_east"  size="0.1,10,0.5" movable="false"><body position="10,0,0"/></box>
    <box id="wall_west"  size="0.1,10,0.5" movable="false"><body position="-10,0,0"/></box>

    <!-- Muro central con puerta -->
    <box id="central_wall_bottom" size="0.1,4.7,0.5" movable="false"><body position="0,-2.65,0"/></box>
    <box id="central_wall_top"    size="0.1,4.7,0.5" movable="false"><body position="0,2.65,0"/></box>

    <!-- Laberinto en la mitad superior izquierda -->

    <!-- Pasillos horizontales alternos -->
    <box id="maze_seg1" size="3.2,0.1,0.5" movable="false"><body position=" -1.6, -0.9 , 0"/></box>
    <box id="maze_seg2" size="2.6, 0.1,0.5" movable="false"><body position=" -1.3, -0.3 , 0"/></box>
    <box id="maze_seg3" size="1.4, 0.1,0.5" movable="false"><body position=" -1.3,  0.3 , 0"/></box>
    <box id="maze_seg4" size="4,   0.1,0.5" movable="false"><body position=" -4.6,  2.3 , 0"/></box>
    <box id="maze_seg5" size="4.6, 0.1,0.5" movable="false"><body position=" -4.9,  3   , 0"/></box>
    
    <!-- Pasillos verticales -->
    <box id="maze_seg6" size="0.1,3,  0.5" movable="false"><body position="-7.2, 1.5 , 0"/></box>
    <box id="maze_seg7" size="0.1,3.2,0.5" movable="false"><body position="-3.2, 0.7 , 0"/></box>
    <box id="maze_seg8" size="0.1,2,  0.5" movable="false"><body position="-2.6, 1.3 , 0"/></box>
    <box id="maze_seg9" size="0.1,2,  0.5" movable="false"><body position="-2.6, 4   , 0"/></box>
    <box id="maze_seg " size="0.1,3.5,0.5" movable="false"><body position="-2  , 2.65, 0"/></box>

  </arena>

  <physics_engines>
    <dynamics2d id="dyn2d"/>
  </physics_engines>

  <media>
    <led id="leds"/>
    <range_and_bearing id="rab"/>
  </media>

  <visualization>
    <qt-opengl lua_editor="true">
      <camera>
        <placements>
          <placement index="0" position="0,0,7" look_at="0,0,0" up="0,1,0" lens_focal_length="12.5"/>
        </placements>
      </camera>
    </qt-opengl>
  </visualization>
</argos-configuration>
