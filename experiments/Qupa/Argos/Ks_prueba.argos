<?xml version="1.0"?>
<argos-configuration>
    <framework>
        <experiment length="6000" ticks_per_second="10" random_seed="187014"/>
        <system threads="0"/>
    </framework>

    <controllers>
        <lua_controller id="lua"> 
            <actuators>
                <differential_steering implementation="default"/>
                <leds implementation="default" medium="leds"/>
                <range_and_bearing implementation="default" medium="rab"/>
            </actuators>
            <sensors>
                <qupa_proximity implementation="default" show_rays="false"/>
                <positioning implementation="default"/>
                <colored_blob_omnidirectional_camera implementation="rot_z_only" medium="leds" show_rays="false"/>
                <range_and_bearing implementation="medium" medium="rab"/>
                <ground implementation="rot_z_only"/>
                <qupa_motor_ground implementation="rot_z_only"/>
            </sensors>
            <params/>
        </lua_controller>

        <lua_controller id="lua_obs"> 
            <actuators>
                <differential_steering implementation="default"/>
                <leds implementation="default" medium="leds"/>
                <range_and_bearing implementation="default" medium="rab"/>
            </actuators>
            <sensors>
                <qupa_proximity implementation="default" show_rays="false"/>
                <positioning implementation="default"/>
                <colored_blob_omnidirectional_camera implementation="rot_z_only" medium="leds" show_rays="true"/>
                <range_and_bearing implementation="medium" medium="rab"/>
                <ground implementation="rot_z_only"/>
                <qupa_motor_ground implementation="rot_z_only"/>
            </sensors>
            <params/>
        </lua_controller>
    </controllers>

    <arena size="3,3,3" center="0,0,0.5">

        <floor id="floor" source="image" path="Arena/floor_Ks.png"/>
    
