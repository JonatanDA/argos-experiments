<?xml version="1.0"?>
<argos-configuration>
    <framework>
        <experiment 
            length="3000" 
            ticks_per_second="10" 
            random_seed = "187014"
            />
        <system threads="0"/>
    </framework>

    <controllers>

        <lua_controller id="lua">
            <actuators>
                <differential_steering implementation="default"/>
                <leds implementation="default" medium="leds"/>
                <range_and_bearing implementation="default" medium="rab"/>
            </actuators>

            <sensors>
                <qupa_proximity implementation="default" show_rays="false"/>
                <positioning implementation="default"/>
                <colored_blob_omnidirectional_camera implementation="rot_z_only" show_rays="true" medium="leds"/>
                <range_and_bearing implementation="medium" medium="rab"/>
                <ground implementation="rot_z_only"/>
                <qupa_motor_ground implementation="rot_z_only"/>
            </sensors>

            <params />
        </lua_controller>

        <lua_controller id="lua_dem">
            <actuators>
                <differential_steering implementation="default"/>
                <leds implementation="default" medium="leds"/>
                <range_and_bearing implementation="default" medium="rab"/>
            </actuators>

            <sensors>
                <qupa_proximity implementation="default" show_rays="false"/>
                <positioning implementation="default"/>
                <colored_blob_omnidirectional_camera implementation="rot_z_only" show_rays="false" medium="leds"/>
                <range_and_bearing implementation="medium" medium="rab"/>
                <ground implementation="rot_z_only"/>
                <qupa_motor_ground implementation="rot_z_only"/>
            </sensors>

            <params />
        </lua_controller>

    </controllers>
 
    <arena size="10,10,5" center="0,0,0.5">

    <!-- light -->
        <!-- <light id="light"
           position="2,2,1"
           orientation="0,0,0"
           color="yellow"
           intensity="3.0"
           medium="leds" /> -->

    <!-- Floor -->
        <!-- <floor id="floor" source="loop_functions" pixels_per_meter="100" /> -->

        <floor id="floor" source="image" path="Arena/floor_Qupa_St.png"/>

    
        <box id="wall_north" size="8,0.1,0.5" movable="false">
        <body position="0,4,0" orientation="0,0,0"/>
        </box>
        <box id="wall_south" size="8,0.1,0.5" movable="false">
        <body position="0,-4,0" orientation="0,0,0"/>
        </box>
        <box id="wall_east" size="0.1,8,0.5" movable="false">
        <body position="4,0,0" orientation="0,0,0"/>
        </box>
        <box id="wall_west" size="0.1,8,0.5" movable="false">
        <body position="-4,0,0" orientation="0,0,0"/>
        </box>        
        
        <!-- qupa4 Maestro -->
        <qupa id="Qupa4" omnidirectional_camera_aperture="72.973"> 
        <body position="-0.6, 0 , 0" orientation="0,0,0"/>
        <controller config="lua_dem"/>
        </qupa> 

        <qupa id="Qupa0" omnidirectional_camera_aperture="72.973"><body position="1.00,0.00,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa1" omnidirectional_camera_aperture="72.973"><body position="0.81,0.59,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa2" omnidirectional_camera_aperture="72.973"><body position="0.31,0.95,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa3" omnidirectional_camera_aperture="72.973"><body position="-0.31,0.95,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa5" omnidirectional_camera_aperture="72.973"> <body position="-0.81,0.59,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa6" omnidirectional_camera_aperture="72.973"><body position="-1.40,0.00,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa7" omnidirectional_camera_aperture="72.973"><body position="-0.81,-0.59,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa8" omnidirectional_camera_aperture="72.973"><body position="-0.31,-0.95,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa9" omnidirectional_camera_aperture="72.973"><body position="0.31,-0.95,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa10" omnidirectional_camera_aperture="72.973"><body position="0.81,-0.59,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa11" omnidirectional_camera_aperture="72.973"><body position="2.00,0.00,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa12" omnidirectional_camera_aperture="72.973"><body position="1.62,1.18,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa13" omnidirectional_camera_aperture="72.973"><body position="0.62,1.90,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa14" omnidirectional_camera_aperture="72.973"><body position="-0.62,1.90,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa15" omnidirectional_camera_aperture="72.973"><body position="-1.62,1.18,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa16" omnidirectional_camera_aperture="72.973"><body position="-2.00,0.00,0" orientation="0,0,0"/><controller config="lua_dem"/></qupa>
        <qupa id="Qupa17" omnidirectional_camera_aperture="72.973"><body position="-1.62,-1.18,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa18" omnidirectional_camera_aperture="72.973"><body position="-0.62,-1.90,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa19" omnidirectional_camera_aperture="72.973"><body position="0.62,-1.90,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa20" omnidirectional_camera_aperture="72.973"><body position="1.62,-1.18,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa21" omnidirectional_camera_aperture="72.973"><body position="3.00,0.00,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa22" omnidirectional_camera_aperture="72.973"><body position="2.43,1.76,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa23" omnidirectional_camera_aperture="72.973"><body position="0.93,2.85,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa24" omnidirectional_camera_aperture="72.973"><body position="-0.93,2.85,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa25" omnidirectional_camera_aperture="72.973"><body position="-2.43,1.76,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa26" omnidirectional_camera_aperture="72.973"><body position="-3.00,0.00,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa27" omnidirectional_camera_aperture="72.973"><body position="-2.43,-1.76,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa28" omnidirectional_camera_aperture="72.973"><body position="-0.93,-2.85,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa29" omnidirectional_camera_aperture="72.973"><body position="0.93,-2.85,0" orientation="0,0,0"/><controller config="lua"/></qupa>
        <qupa id="Qupa30" omnidirectional_camera_aperture="72.973"><body position="2.43,-1.76,0" orientation="0,0,0"/><controller config="lua"/></qupa>

    </arena>  


    <physics_engines>
        <dynamics2d id="dyn2d"/>
    </physics_engines>

    <media>
        <range_and_bearing id="rab"/>
        <led id="leds"/>
    </media>

    <!-- <user_functions library="librobot_id_qtuser_functions.so"/> -->

