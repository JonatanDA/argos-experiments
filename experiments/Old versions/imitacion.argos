<?xml version="1.0"?>
<argos-configuration>
    <framework>
        <experiment 
            length="1000" 
            ticks_per_second="10" 
            />
        <system threads="0"/>
    </framework>

    <controllers>

        <lua_controller id="lua">
            <actuators>
                <differential_steering implementation="default" />
                <leds implementation="default" medium="leds"/>   
            </actuators>          
            <sensors>
                <epuck_proximity implementation="default"/>
                <positioning implementation="default" />            
                <epuck_omnidirectional_camera implementation="rot_z_only" show_rays="true" medium="leds" range="0.025:8.03" aperture="0"/> 
                <cameras implementation="default" show_frustum="true"> 
                    <camera id="camera0"
                            range="0.025:4.0"
                            anchor="origin"
                            position="0.1, 0, 0.1"
                            orientation="90, -90, 0"
                            focal_length="800, 800"
                            principal_point="320, 240"
                            resolution="640, 480"/>
                </cameras>
            </sensors>
            <params />
        </lua_controller>

    </controllers>
 
    <arena size="5,5,1" center="0,0,0.5">
    <!-- Floor -->
        <floor id="floor" source="loop_functions" pixels_per_meter="100" />
    
        <box id="wall_north" size="4,0.1,0.5" movable="false">
        <body position="0,2,0" orientation="0,0,0"/>
        </box>
        <box id="wall_south" size="4,0.1,0.5" movable="false">
        <body position="0,-2,0" orientation="0,0,0"/>
        </box>
        <box id="wall_east" size="0.1,4,0.5" movable="false">
        <body position="2,0,0" orientation="0,0,0"/>
        </box>
        <box id="wall_west" size="0.1,4,0.5" movable="false">
        <body position="-2,0,0" orientation="0,0,0"/>
        </box>
<!--
        <e-puck id="epuck0" >
            <body position="-0.5,-0.5,0" orientation="0,0,0" />
            <controller config="lua"/>     
        </e-puck>
        <e-puck id="epuck2" >
            <body position="-0.6,-0.45,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>
        <e-puck id="epuck4" >
            <body position="-0.4,-0.6,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>     

        <e-puck id="epuck1" >
            <body position="0.5,-0.5,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>
        <e-puck id="epuck3" >
            <body position="0.3,-0.3,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>
        <e-puck id="epuck5" >
            <body position="0.6,-0.6,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>   
-->
        <e-puck id="epuck0" >
            <body position="-0.5,-0.5,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>
        <e-puck id="epuck1" >
            <body position="0.5,-0.5,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>
        <e-puck id="epuck2" >
            <body position="-1.6,-1.7,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>
        <e-puck id="epuck3" >
            <body position="1.4,-1.7,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>
        <e-puck id="epuck4" >
            <body position="-0.3,-0.3,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>
        <e-puck id="epuck5" >
            <body position="0.7,-0.3,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>        

    </arena> 


    <physics_engines>
        <dynamics2d id="dyn2d"/>
    </physics_engines>

    <media>
        <led id="leds"/>
    </media>


    <visualization >
        <qt-opengl lua_editor="true">
            <camera>
                <placements>
                <placement index="0" position="0,0,4.34" look_at="0,0,0" up="1,0,0" lens_focal_length="35" />
                </placements>
            </camera>
        </qt-opengl>
    </visualization>
    
</argos-configuration>