<?xml version="1.0"?>
<argos-configuration>
    <framework>
        <experiment 
            length="1000" 
            ticks_per_second="10" 
            random_seed = "721549"
            />
        <system threads="0"/>
    </framework>

    <controllers>

        <lua_controller id="lua">
            <actuators>
                <differential_steering implementation="default" />
                <leds implementation="default" medium="leds"/>   
            </actuators>          
            <sensors>
                <epuck_proximity implementation="default" show_rays="true" />
                <positioning implementation="default" />            
                <epuck_omnidirectional_camera implementation="rot_z_only" show_rays="true" medium="leds"/> 
            </sensors>
            <params />
        </lua_controller>

    </controllers>
 
    <arena size="5,5,1" center="0,0,0.5">
    <!-- Floor -->
        <floor id="floor" source="loop_functions" pixels_per_meter="100" />
    
        <box id="wall_north" size="4,0.1,0.5" movable="false">
        <body position="0,2,0" orientation="0,0,0"/>
        </box>
        <box id="wall_south" size="4,0.1,0.5" movable="false">
        <body position="0,-2,0" orientation="0,0,0"/>
        </box>
        <box id="wall_east" size="0.1,4,0.5" movable="false">
        <body position="2,0,0" orientation="0,0,0"/>
        </box>
        <box id="wall_west" size="0.1,4,0.5" movable="false">
        <body position="-2,0,0" orientation="0,0,0"/>
        </box>
    <!--    -->
        <e-puck id="epuck0" >
            <body position="-0.5,-0.5,0" orientation="0,0,0" />
            <controller config="lua"/>     
        </e-puck>
        <e-puck id="epuck2" >
            <body position="-0.7,0.0,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>
        <e-puck id="epuck4" >
            <body position="-0.5,0.5,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>     

        <e-puck id="epuck1" >
            <body position="0.5,-0.5,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>
        <e-puck id="epuck3" >
            <body position="0.7,-0.0,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>
        <e-puck id="epuck5" >
            <body position="0.5,0.5,0" orientation="0,0,0" />
            <controller config="lua"/>
        </e-puck>   


  
    </arena> 


    <physics_engines>
        <dynamics2d id="dyn2d"/>
    </physics_engines>

    <media>
        <led id="leds"/>
    </media>


    <visualization >
        <qt-opengl lua_editor="true">
            <camera>
                <placements>
                <placement index="0" position="0,0,4.34" look_at="0,0,0" up="0,1,0" lens_focal_length="25" />
                </placements>
            </camera>

            <frame_grabbing directory="Resultados/Robots/E-puck/step6/frame" 
                base_name="frame_" 
                format="png" 
                quality="100" />

        </qt-opengl>
    </visualization>
    
</argos-configuration>