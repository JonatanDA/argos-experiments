<?xml version='1.0' encoding='utf-8'?>
<argos-configuration>
    <framework>
        <experiment length="5000" ticks_per_second="4" />
        <system threads="0" />
    </framework>
            
            
<controllers>

        <lua_controller id="lua"> 
            <actuators>
                <differential_steering implementation="default" />
                <leds implementation="default" medium="leds" />
                <range_and_bearing implementation="default" medium="rab" />
            </actuators>
            <sensors>
                <qupa_proximity implementation="default" show_rays="false" />
                <positioning implementation="default" />
                <colored_blob_omnidirectional_camera implementation="rot_z_only" medium="leds" show_rays="false" />
                <range_and_bearing implementation="medium" medium="rab" />
                <qupa_motor_ground implementation="rot_z_only" />
                <qupa_base_ground implementation="rot_z_only" />
            </sensors>
            <params script="experiments/Qupa/Controller/Ks4/temp_95074_Ks4.lua" />
        </lua_controller>

        <lua_controller id="lua_obs"> 
            <actuators>
                <differential_steering implementation="default" />
                <leds implementation="default" medium="leds" />
                <range_and_bearing implementation="default" medium="rab" />
            </actuators>
            <sensors>
                <qupa_proximity implementation="default" show_rays="true" />
                <positioning implementation="default" />
                
                <colored_blob_omnidirectional_camera implementation="rot_z_only" medium="leds" show_rays="true" noise_std_dev="0.0" />

                <range_and_bearing implementation="medium" medium="rab" />
                <qupa_motor_ground implementation="rot_z_only" />
                <qupa_base_ground implementation="rot_z_only" />
            </sensors>
            <params script="experiments/Qupa/Controller/Ks4/temp_95074_Ks4.lua" />
        </lua_controller>

    </controllers>

    <arena size="3,3,3" center="0,0,0.5">

        
            

        
        
        
        <floor id="floor" source="image" path="Arena/floor_Ks.png" />
    
        <box id="wall_north" size="3,0.1,0.5" movable="false">
        <body position="0,1.5,0" orientation="0,0,0" />
        </box>
        <box id="wall_south" size="3,0.1,0.5" movable="false">
        <body position="0,-1.5,0" orientation="0,0,0" />
        </box>
        <box id="wall_east" size="0.1,3,0.5" movable="false">
        <body position="1.5,0,0" orientation="0,0,0" />
        </box>
        <box id="wall_west" size="0.1,3,0.5" movable="false">
        <body position="-1.5,0,0" orientation="0,0,0" />
        </box>


        <qupa id="Qupa0"><body position="-1.00,-0.50,0" orientation="0,0,0" /><controller config="lua" /></qupa>
        <qupa id="Qupa1"><body position="-0.50,-1.00,0" orientation="0,0,0" /><controller config="lua" /></qupa>

        <qupa id="Qupa2"><body position="-0.75,0.75,0" orientation="0,0,0" /><controller config="lua" /></qupa>
        <qupa id="Qupa3"><body position="0.00,0.00,0" orientation="0,0,0" /><controller config="lua" /></qupa>
        <qupa id="Qupa5"><body position="0.75,-0.75,0" orientation="0,0,0" /><controller config="lua" /></qupa>
        
        <qupa id="Qupa6"><body position="0.50,1.00,0" orientation="0,0,0" /><controller config="lua" /></qupa>
        <qupa id="Qupa7"><body position="1.00,0.50,0" orientation="0,0,0" /><controller config="lua" /></qupa>

        <qupa id="Qupa4" omnidirectional_camera_aperture="72.1">
            <body position="-1.2,-1.2,0" orientation="0,0,0" />
            <controller config="lua_obs" />
        </qupa> 
        
        

    </arena> 


    <physics_engines>
        <dynamics2d id="dyn2d" />
    </physics_engines>

    <media>
        <range_and_bearing id="rab" />
        <led id="leds" />
    </media>

        
        
    <visualization>
    <qt-opengl lua_editor="true">
        <camera>
        <placements>
            <placement index="0" position="0,0,4.34" look_at="0,0,0" up="0,1,0" lens_focal_length="37" />
        </placements>
        </camera>

        <frame_grabbing directory="Resultados/Robots/Qupa/Ks1/video_dem/frame" base_name="frame_" format="png" quality="100" />

    </qt-opengl>
    </visualization>

    
</argos-configuration>